# riskcore 配置（占位值示例；真实 .env 已加入 .gitignore，禁入库）
# 复制为 .env 或直接以环境变量注入。

# 存储：SQLite 开发库路径（生产为 PostgreSQL，见 areas/event-log/ddl/postgres/）
RISKCORE_DB=.tmp/riskcore.db

# 租户（服务端强制；裸调用 401）
RISKCORE_TENANT=t1

# HTTP 端口
RISKCORE_PORT=8000

# 投影/对账调度周期（秒）
RISKCORE_TICK_SECONDS=60

# 谓词模式：observe=旁路观察（只记不拦，W-006 默认）｜ enforce=真拦截（W-010 切流后）
# 切流门禁：披露层人工试用通过 + 双跑 14 天差异全部有裁决（STATUS.md）
RISKCORE_PREDICATE_MODE=observe

# 双跑：legacy 每日快照落盘区（W-009；运维每日导出 risk_code_assignments 放这里）
RISKCORE_LEGACY_DIR=.tmp/legacy_snapshots
